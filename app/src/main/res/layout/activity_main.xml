<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="8dp" android:background="@color/white">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Проверка.29" android:textColor="@color/primary" android:textSize="20sp" android:textStyle="bold"/>
  <Button android:id="@+id/menuButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Меню"/>
 </LinearLayout>
 <ProgressBar android:id="@+id/pageProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:progressTint="@color/primary" android:visibility="gone"/>
 <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
   <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent"/>
   <include android:id="@+id/offlinePanel" layout="@layout/offline" android:visibility="gone"/>
  </FrameLayout>
 </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>