 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Нет подключения к интернету" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:gravity="center"/>
 <TextView android:id="@+id/offlineMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Проверьте соединение и попробуйте снова." android:textColor="@color/text_secondary" android:gravity="center"/>
